{
 "cells": [
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "dbe05f76",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Customer Segmentation using K-Means Clustering\n",
    "# Profiles: Midnight Shopper, Weekend Buyer, Cart Addict, Casual Buyer\n",
    "import pandas as pd \n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt \n",
    "\n",
     "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.metrics import silhouette_score\n",
    "from sklearn.cluster import KMeans"
   ]
  },
   {
    "cell_type": "code",
    "execution_count": null,
    "id": "load_data",
    "metadata": {},
    "outputs": [],
    "source": [
     "# Load data with fallback paths\n",
    "import os\n",
    "if os.path.exists(\"processed/full_data_engineered.parquet\"):\n",
    "    df = pd.read_parquet(\"processed/full_data_engineered.parquet\", engine=\"fastparquet\")\n",
    "elif os.path.exists(\"processed/full_data.parquet\"):\n",
    "    df = pd.read_parquet(\"processed/full_data.parquet\", engine=\"fastparquet\")\n",
    "else:\n",
    "    # Fallback: load from CSV\n",
    "    orders = pd.read_csv(\"../datasets/orders.csv\")\n",
    "    order_products = pd.read_csv(\"../datasets/order_products.csv\")\n",
    "    products = pd.read_csv(\"../datasets/products.csv\")\n",
    "    aisles = pd.read_csv(\"../datasets/aisles.csv\")\n",
    "    departments = pd.read_csv(\"../datasets/departments.csv\")\n",
    "    df = order_products.merge(orders, on='order_id')\\\n",
    "        .merge(products, on='product_id')\\\n",
    "        .merge(aisles, on='aisle_id')\\\n",
    "        .merge(departments, on='department_id')\n",
    "\n",
    "print(f\"Data shape: {df.shape}\")"
   ]
  },
   {
    "cell_type": "code",
    "execution_count": null,
    "id": "create_features",
    "metadata": {},
    "outputs": [],
    "source": [
     "# Create customer features\n",
    "customer_features = df.groupby('user_id').agg({\n",
    "    'product_id': 'count',        # total products ordered\n",
    "    'order_number': 'max',        # total orders\n",
    "    'order_hour_of_day': 'mean',  # preferred shopping hour\n",
    "    'order_dow': 'mean',          # preferred day of week (0=Sun)\n",
    "    'days_since_prior_order': 'mean',  # avg days between orders\n",
    "}).reset_index()\n",
    "\n",
    "customer_features.rename(columns={\n",
    "    'product_id': 'total_products',\n",
    "    'order_number': 'total_orders',\n",
    "    'order_hour_of_day': 'avg_order_hour',\n",
    "    'order_dow': 'avg_order_dow',\n",
    "    'days_since_prior_order': 'avg_days_between_orders'\n",
    "}, inplace=True)\n",
    "\n",
    "# Calculate average cart size per order\n",
    "cart_sizes = df.groupby(['user_id', 'order_id']).size().reset_index(name='cart_size')\n",
    "avg_cart = cart_sizes.groupby('user_id')['cart_size'].mean().reset_index()\n",
    "avg_cart.rename(columns={'cart_size': 'avg_cart_size'}, inplace=True)\n",
    "\n",
    "customer_features = customer_features.merge(avg_cart, on='user_id')\n",
    "\n",
    "print(f\"Number of unique customers: {len(customer_features)}\")\n",
    "print(customer_features.head())\n",
    "\n",
    "# Handle NaN values in days_since_prior_order (first orders have NaN)\n",
    "customer_features['avg_days_between_orders'] = customer_features['avg_days_between_orders'].fillna(0)"
   ]
  },
   {
    "cell_type": "code",
    "execution_count": null,
    "id": "elbow_method",
    "metadata": {},
    "outputs": [],
    "source": [
     "# Elbow Method to find optimal k with Silhouette Score\n",
    "X = customer_features[['total_products', 'total_orders', 'avg_order_hour', 'avg_order_dow', 'avg_cart_size', 'avg_days_between_orders']]\n",
    "\n",
     "scaler = StandardScaler()\n",
    "X_scaled = scaler.fit_transform(X)\n",
    "X_scaled = np.nan_to_num(X_scaled)  # Safety net for any remaining NaNs"
    "\n",
    "inertias = []\n",
    "silhouette_scores = []\n",
    "K_range = range(2, 11)\n",
    "\n",
    "for k in K_range:\n",
    "    kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)\n",
    "    kmeans.fit(X_scaled)\n",
    "    inertias.append(kmeans.inertia_)\n",
    "    silhouette_scores.append(silhouette_score(X_scaled, kmeans.labels_))\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "# Elbow plot\n",
    "axes[0].plot(K_range, inertias, 'bo-')\n",
    "axes[0].set_xlabel('Number of Clusters (k)')\n",
    "axes[0].set_ylabel('Inertia')\n",
    "axes[0].set_title('Elbow Method for Optimal k')\n",
    "axes[0].grid(True)\n",
    "\n",
    "# Silhouette score plot\n",
    "axes[1].plot(K_range, silhouette_scores, 'go-')\n",
    "axes[1].set_xlabel('Number of Clusters (k)')\n",
    "axes[1].set_ylabel('Silhouette Score')\n",
    "axes[1].set_title('Silhouette Score by Cluster Count')\n",
    "axes[1].grid(True)\n",
    "\n",
    "best_k = K_range[np.argmax(silhouette_scores)]\n",
    "print(f\"Best k by Silhouette Score: {best_k} (score: {max(silhouette_scores):.4f})\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('customer_segmentation_elbow.png', dpi=100, bbox_inches='tight')\n",
    "plt.show()\n",
    "print(\"Elbow + Silhouette plot saved to customer_segmentation_elbow.png\")"
   ]
  },
   {
    "cell_type": "code",
    "execution_count": null,
    "id": "kmeans_fit",
    "metadata": {},
    "outputs": [],
    "source": [
     "# Fit K-Means with k=4 (as per README profiles)\n",
    "kmeans = KMeans(n_clusters=4, random_state=42, n_init=10)\n",
    "customer_features['segment'] = kmeans.fit_predict(X_scaled)\n",
    "\n",
    "# Analyze segment statistics\n",
    "segment_stats = customer_features.groupby('segment').agg({\n",
    "    'total_products': 'mean',\n",
    "    'total_orders': 'mean',\n",
    "    'avg_order_hour': 'mean',\n",
    "    'avg_order_dow': 'mean',\n",
    "    'avg_cart_size': 'mean',\n",
    "    'avg_days_between_orders': 'mean',\n",
    "    'user_id': 'count'\n",
    "}).rename(columns={'user_id': 'customer_count'})\n",
    "\n",
    "print(\"Segment Statistics:\")\n",
    "print(segment_stats.round(2))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "segment_naming",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Map segments to business-friendly profiles based on behavior\n",
    "# Analyze characteristics to assign proper names\n",
    "segment_analysis = segment_stats.copy()\n",
    "\n",
    "# Create mapping based on behavior patterns\n",
    "segment_mapping = {}\n",
    "for seg in segment_analysis.index:\n",
    "    row = segment_analysis.loc[seg]\n",
    "    \n",
    "    if row['avg_order_hour'] < 6 or row['avg_order_hour'] > 22:\n",
    "        segment_mapping[seg] = 'Midnight Shopper'\n",
    "    elif row['avg_order_dow'] >= 5:  # Saturday = 6, Sunday = 0 in some systems, let's use >=5 for weekend\n",
    "        segment_mapping[seg] = 'Weekend Buyer'\n",
    "    elif row['total_orders'] > 50 and row['avg_cart_size'] > 10:\n",
    "        segment_mapping[seg] = 'Cart Addict'\n",
    "    else:\n",
    "        segment_mapping[seg] = 'Casual Buyer'\n",
    "\n",
    "# Better approach: rank segments by key metrics\n",
    "segment_order = segment_stats.sort_values('total_orders', ascending=False).index.tolist()\n",
    "profiles = ['Cart Addict', 'Weekend Buyer', 'Casual Buyer', 'Midnight Shopper']\n",
    "segment_mapping = dict(zip(segment_order, profiles))\n",
    "\n",
    "customer_features['profile'] = customer_features['segment'].map(segment_mapping)\n",
    "\n",
    "print(\"Segment to Profile Mapping:\")\n",
    "for seg, profile in segment_mapping.items():\n",
    "    print(f\"  Segment {seg} -> {profile}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "visualization",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualize clusters\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "# Plot 1: Total Orders vs Average Order Hour\n",
    "colors = ['#1f77b4', '#ff7f0e', '#2ca02c', '#d62728']\n",
    "for seg in range(4):\n",
    "    mask = customer_features['segment'] == seg\n",
    "    axes[0].scatter(\n",
    "        customer_features.loc[mask, 'total_orders'],\n",
    "        customer_features.loc[mask, 'avg_order_hour'],\n",
    "        c=colors[seg], label=segment_mapping.get(seg, f'Segment {seg}'),\n",
    "        alpha=0.5, s=10\n",
    "    )\n",
    "axes[0].set_xlabel('Total Orders')\n",
    "axes[0].set_ylabel('Average Order Hour')\n",
    "axes[0].set_title('Customer Segments: Orders vs Hour')\n",
    "axes[0].legend()\n",
    "axes[0].grid(True, alpha=0.3)\n",
    "\n",
    "# Plot 2: Cart Size vs Total Products\n",
    "for seg in range(4):\n",
    "    mask = customer_features['segment'] == seg\n",
    "    axes[1].scatter(\n",
    "        customer_features.loc[mask, 'total_products'],\n",
    "        customer_features.loc[mask, 'avg_cart_size'],\n",
    "        c=colors[seg], label=segment_mapping.get(seg, f'Segment {seg}'),\n",
    "        alpha=0.5, s=10\n",
    "    )\n",
    "axes[1].set_xlabel('Total Products Ordered')\n",
    "axes[1].set_ylabel('Average Cart Size')\n",
    "axes[1].set_title('Customer Segments: Products vs Cart Size')\n",
    "axes[1].legend()\n",
    "axes[1].grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('customer_segmentation_scatter.png', dpi=100, bbox_inches='tight')\n",
    "plt.show()\n",
    "print(\"Scatter plots saved to customer_segmentation_scatter.png\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "department_analysis",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Analyze department preferences per segment\n",
    "df_with_segments = df.merge(customer_features[['user_id', 'segment', 'profile']], on='user_id')\n",
    "\n",
    "dept_by_segment = df_with_segments.groupby(['profile', 'department']).size().unstack(fill_value=0)\n",
    "\n",
    "# Convert to percentages\n",
    "dept_pct = dept_by_segment.div(dept_by_segment.sum(axis=1), axis=0) * 100\n",
    "\n",
    "# Plot top departments by segment\n",
    "top_departments = df['department'].value_counts().head(8).index.tolist()\n",
    "dept_pct_top = dept_pct[top_departments]\n",
    "\n",
    "dept_pct_top.T.plot(kind='bar', figsize=(12, 6))\n",
    "plt.xlabel('Department')\n",
    "plt.ylabel('Percentage of Orders (%)')\n",
    "plt.title('Department Preferences by Customer Segment')\n",
    "plt.legend(title='Profile', bbox_to_anchor=(1.02, 1))\n",
    "plt.xticks(rotation=45, ha='right')\n",
    "plt.tight_layout()\n",
    "plt.savefig('customer_segmentation_departments.png', dpi=100, bbox_inches='tight')\n",
    "plt.show()\n",
    "print(\"Department analysis saved to customer_segmentation_departments.png\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "aisle_analysis",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Analyze aisle preferences per segment (top aisles)\n",
    "aisle_by_segment = df_with_segments.groupby(['profile', 'aisle']).size().unstack(fill_value=0)\n",
    "\n",
    "# Convert to percentages\n",
    "aisle_pct = aisle_by_segment.div(aisle_by_segment.sum(axis=1), axis=0) * 100\n",
    "\n",
    "# Get top 10 aisles overall\n",
    "top_aisles = df['aisle'].value_counts().head(10).index.tolist()\n",
    "aisle_pct_top = aisle_pct[top_aisles]\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(14, 6))\n",
    "aisle_pct_top.T.plot(kind='barh', ax=ax)\n",
    "plt.xlabel('Percentage of Orders (%)')\n",
    "plt.ylabel('Aisle')\n",
    "plt.title('Top 10 Aisle Preferences by Customer Segment')\n",
    "plt.legend(title='Profile', bbox_to_anchor=(1.02, 1))\n",
    "plt.tight_layout()\n",
    "plt.savefig('customer_segmentation_aisles.png', dpi=100, bbox_inches='tight')\n",
    "plt.show()\n",
    "print(\"Aisle analysis saved to customer_segmentation_aisles.png\")\n",
    "\n",
    "# Show top aisles per segment\n",
    "print(\"\\nTop 3 Aisle Preferences per Segment:\")\n",
    "for profile in aisle_pct.index:\n",
    "    top3 = aisle_pct.loc[profile].nlargest(3)\n",
    "    print(f\"\\n  {profile}:\")\n",
    "    for aisle, pct in top3.items():\n",
    "        print(f\"    - {aisle}: {pct:.1f}%\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "summary",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Final Summary\n",
    "print(\"=\" * 60)\n",
    "print(\"CUSTOMER SEGMENTATION SUMMARY\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "for seg in sorted(customer_features['segment'].unique()):\n",
    "    profile = segment_mapping[seg]\n",
    "    stats = segment_stats.loc[seg]\n",
    "    count = int(stats['customer_count'])\n",
    "    pct = count / len(customer_features) * 100\n",
    "    \n",
    "    print(f\"\\n{profile} (Segment {seg}):\")\n",
    "    print(f\"  - Customers: {count:,} ({pct:.1f}%)\")\n",
    "    print(f\"  - Avg Orders: {stats['total_orders']:.1f}\")\n",
    "    print(f\"  - Avg Products: {stats['total_products']:.1f}\")\n",
    "    print(f\"  - Avg Cart Size: {stats['avg_cart_size']:.1f}\")\n",
    "    print(f\"  - Avg Order Hour: {stats['avg_order_hour']:.1f}\")\n",
     "    print(f\"  - Avg Order Day: {stats['avg_order_dow']:.1f} (0=Sun, 6=Sat)\")\n",
    "    print(f\"  - Avg Days Between Orders: {stats['avg_days_between_orders']:.1f}\")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 60)\n",
    "# Save customer features with segments\n",
    "customer_features.to_parquet('processed/customer_segments.parquet', index=False)\n",
    "print(\"Customer segments saved to processed/customer_segments.parquet\")"
   ]
  }
 ],
